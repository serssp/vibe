{
  "name": "vibe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.domain.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs --output-type err src",
    "test": "vitest run",
    "test:browser": "node tests/browser-check.mjs && node tests/storage-browser-check.mjs && node tests/learning-browser-check.mjs",
    "check:cors": "node tests/live-cors-check.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:architecture && npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
